--- a/src/thread.h
+++ b/src/thread.h
@@ -45,7 +45,9 @@ class Thread {
   std::condition_variable cv;
   size_t idx;
   bool exit = false, searching = true; // Set before starting std::thread
+#ifndef SINGLE_THREAD
   NativeThread stdThread;
+#endif
 
 public:
   explicit Thread(size_t);
